# ==============================================================================
*.parquet
*.csv
*.tsv
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3

# Data directories
data/*
!data/.gitkeep
raw_data/
processed_data/

# GeoProviderService large files & standalone HTML visual dumps
GeoProviderService/*.csv
GeoProviderService/*.parquet
GeoProviderService/*.html

# ==============================================================================
# Logs, Temp Files & Caches
